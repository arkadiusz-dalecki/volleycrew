{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {"exception_type": {"()": "app.safe_logging.ExceptionTypeOnly"}},
  "formatters": {"default": {"format": "[volleycrew] %(levelname)s %(message)s"}},
  "handlers": {"default": {"class": "logging.StreamHandler", "formatter": "default", "filters": ["exception_type"], "stream": "ext://sys.stderr"}},
  "loggers": {
    "uvicorn": {"handlers": ["default"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"handlers": ["default"], "level": "INFO", "propagate": false},
    "uvicorn.access": {"handlers": [], "level": "WARNING", "propagate": false}
  },
  "root": {"handlers": ["default"], "level": "INFO"}
}
